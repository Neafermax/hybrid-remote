<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@color/bg_main">

    <!-- SIDEBAR -->
    <LinearLayout
        android:layout_width="140dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/bg_sidebar"
        android:paddingTop="24dp"
        android:paddingHorizontal="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ATV + IR"
            android:textColor="@color/accent_blue"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btnModeWifi"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mando Wi-Fi"
            android:textColor="@color/text_primary"
            android:background="@color/accent_blue"
            android:padding="14dp"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btnModeIr"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mando Infrarrojo"
            android:textColor="@color/text_secondary"
            android:background="@color/bg_button"
            android:padding="14dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="● Desconectado"
            android:textColor="@color/status_error"
            android:textSize="12sp"
            android:layout_marginBottom="16dp" />
    </LinearLayout>

    <!-- PANEL PRINCIPAL -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingTop="30dp">

        <TextView
            android:id="@+id/tvModeTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Modo: Android TV (Wi-Fi)"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/etTvIp"
            android:layout_width="220dp"
            android:layout_height="wrap_content"
            android:hint="IP de tu TV / TV Box"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:background="@color/bg_button"
            android:padding="10dp"
            android:inputType="text"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btnConnect"
            android:layout_width="220dp"
            android:layout_height="wrap_content"
            android:text="Conectar"
            android:backgroundTint="@color/accent_blue"
            android:layout_marginBottom="30dp" />

        <!-- D-PAD -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_marginBottom="30dp">

            <Button android:id="@+id/btnUp" android:layout_width="72dp" android:layout_height="72dp"
                android:text="▲" android:backgroundTint="@color/bg_button" android:textColor="@color/text_primary" />

            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
                <Button android:id="@+id/btnLeft" android:layout_width="72dp" android:layout_height="72dp"
                    android:text="◄" android:backgroundTint="@color/bg_button" android:textColor="@color/text_primary" />
                <Button android:id="@+id/btnOk" android:layout_width="72dp" android:layout_height="72dp"
                    android:text="OK" android:backgroundTint="#2A2D37" android:textColor="@color/text_primary" />
                <Button android:id="@+id/btnRight" android:layout_width="72dp" android:layout_height="72dp"
                    android:text="►" android:backgroundTint="@color/bg_button" android:textColor="@color/text_primary" />
            </LinearLayout>

            <Button android:id="@+id/btnDown" android:layout_width="72dp" android:layout_height="72dp"
                android:text="▼" android:backgroundTint="@color/bg_button" android:textColor="@color/text_primary" />
        </LinearLayout>

        <!-- ACCIONES -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button android:id="@+id/btnPower" android:layout_width="90dp" android:layout_height="56dp"
                android:text="⏻ Encender" android:textSize="11sp" android:backgroundTint="@color/bg_button" android:textColor="@color/text_primary" android:layout_marginEnd="8dp"/>
            <Button android:id="@+id/btnHome" android:layout_width="90dp" android:layout_height="56dp"
                android:text="🏠 Inicio" android:textSize="11sp" android:backgroundTint="@color/bg_button" android:textColor="@color/text_primary" android:layout_marginEnd="8dp"/>
            <Button android:id="@+id/btnBack" android:layout_width="90dp" android:layout_height="56dp"
                android:text="↩ Atrás" android:textSize="11sp" android:backgroundTint="@color/bg_button" android:textColor="@color/text_primary" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
