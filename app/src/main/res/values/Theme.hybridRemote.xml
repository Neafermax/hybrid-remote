<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.HybridRemote" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@color/bg_main</item>
        <item name="colorPrimary">@color/accent_blue</item>
        <item name="colorOnPrimary">@color/text_primary</item>
</style>
    
   <style name="ShortcutSlot">
    <item name="android:layout_width">0dp</item>
    <item name="android:layout_height">60dp</item>
    <item name="android:layout_weight">1</item>
    <item name="android:layout_marginHorizontal">4dp</item>
    <item name="android:gravity">center</item>
    <item name="android:textSize">20sp</item>
    <item name="android:background">@drawable/bg_shortcut</item>
</style>

<style name="RoundIconButton">
    <item name="android:layout_width">50dp</item>
    <item name="android:layout_height">50dp</item>
    <item name="android:layout_margin">4dp</item>
    <item name="android:gravity">center</item>
    <item name="android:textSize">16sp</item>
    <item name="android:background">@drawable/bg_round_button</item>
</style>

<style name="OutlinePillButton">
    <item name="android:layout_width">wrap_content</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:layout_margin">4dp</item>
    <item name="android:paddingHorizontal">16dp</item>
    <item name="android:paddingVertical">10dp</item>
    <item name="android:textColor">@color/text_primary</item>
    <item name="android:background">@drawable/bg_outline_button</item>
</style>

<style name="NumberButton">
    <item name="android:layout_width">0dp</item>
    <item name="android:layout_height">64dp</item>
    <item name="android:layout_weight">1</item>
    <item name="android:layout_margin">4dp</item>
    <item name="android:textSize">20sp</item>
    <item name="android:backgroundTint">@color/bg_button</item>
    <item name="android:textColor">@color/text_primary</item>
</style>

<style name="ColorButton">
    <item name="android:layout_width">0dp</item>
    <item name="android:layout_height">44dp</item>
    <item name="android:layout_weight">1</item>
    <item name="android:layout_margin">4dp</item>
    <item name="android:gravity">center</item>
    <item name="android:textStyle">bold</item>
    <item name="android:background">@drawable/bg_outline_button</item>
</style>
</resources>
